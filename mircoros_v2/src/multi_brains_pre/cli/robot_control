@call_tool_app.command(name='TargetTrack')
async def TargetTrack(
    *,
    x1_or_cmd: Annotated[str, cyclopts.Parameter(help=" If input is a string cancel, it will stop the current tracking. If input is an integer, it will be treated as the x1 coordinate of the bounding box for target tracking")],
    y1: Annotated[str | None, cyclopts.Parameter(help="")] = None,
    x2: Annotated[str | None, cyclopts.Parameter(help="")] = None,
    y2: Annotated[str | None, cyclopts.Parameter(help="")] = None,
) -> None:
    '''Visual tracking of target objects'''
    # Parse JSON parameters, fallback to raw string if not valid JSON
    def _parse(val):
        if val is None:
            return None
        try:
            return json.loads(val)
        except json.JSONDecodeError:
            return val
    x1_or_cmd_parsed = _parse(x1_or_cmd)
    y1_parsed = _parse(y1)
    x2_parsed = _parse(x2)
    y2_parsed = _parse(y2)
    await _call_tool('TargetTrack', {'x1_or_cmd': x1_or_cmd_parsed, 'y1': y1_parsed, 'x2': x2_parsed, 'y2': y2_parsed})

